    private void btnGuardarActionPerformed(java.awt.event.ActionEvent evt) {                                           
        guardarProducto();
         FormularioVenta formularioVenta = new FormularioVenta();
        formularioVenta.setVisible(true); 
        
        
        dispose();
    }                                          

