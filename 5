    private void guardarProducto() {
        String sql = "INSERT INTO Producto (CodProducto, DescProducto, Precio, Stock, Indicador) VALUES (?, ?, ?, ?, 'A')";
        
        try (Connection conexion = conexionBD.getConexion();
             PreparedStatement stmt = conexion.prepareStatement(sql)) {

            
            stmt.setInt(1, Integer.parseInt(txtCodProducto.getText()));  
            stmt.setString(2, txtDescProducto.getText());  
            stmt.setDouble(3, Double.parseDouble(txtPrecio.getText()));  
            stmt.setInt(4, Integer.parseInt(txtStock.getText()));  

           
            stmt.executeUpdate();
            JOptionPane.showMessageDialog(this, "Producto guardado correctamente");
        } catch (SQLException e) {
            JOptionPane.showMessageDialog(this, "Error al guardar el producto: " + e.getMessage());
        }
    }

    
    private void limpiarCampos() {
        txtCodProducto.setText("");
        txtDescProducto.setText("");
        txtPrecio.setText("");
        txtStock.setText("");
    }

    
    private void cancelarFormulario() {
        this.dispose(); 
    }
   
