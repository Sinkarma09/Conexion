    private void guardarCliente() {
        String sql = "INSERT INTO Cliente (CodCliente, Nombres, Ape_Paterno, Ape_Materno, Ruc, RazonSocial, Telefono, Indicador) VALUES (?, ?, ?, ?, ?, ?, ?, 'A')";
        
        try (Connection conexion = conexionBD.getConexion();
             PreparedStatement stmt = conexion.prepareStatement(sql)) {

            stmt.setInt(1, Integer.parseInt(txtCodCliente.getText()));
            stmt.setString(2, txtNombres.getText());
            stmt.setString(3, txtApePaterno.getText());
            stmt.setString(4, txtApeMaterno.getText());
            stmt.setString(5, txtRuc.getText());
            stmt.setString(6, txtRazonSocial.getText());
            stmt.setString(7, txtTelefono.getText());

            stmt.executeUpdate();
            JOptionPane.showMessageDialog(this, "Cliente guardado correctamente");
        } catch (SQLException ex) {
            JOptionPane.showMessageDialog(this, "Error al guardar el cliente: " + ex.getMessage());
        }
    }

