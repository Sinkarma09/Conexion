   private void guardarVenta() {
        String sql = "INSERT INTO Venta (CodVenta, FechaVenta, MontoTotal, MontoIGV) VALUES (?, ?, ?, ?)";
        
        try (Connection conexion = conexionBD.getConexion();
             PreparedStatement stmt = conexion.prepareStatement(sql)) {

            // Obtener los datos del formulario
            stmt.setInt(1, Integer.parseInt(txtCodVenta.getText()));  
            stmt.setString(2, txtFechaVenta.getText());  // FechaVenta
            stmt.setDouble(3, Double.parseDouble(txtMontoTotal.getText()));  
            stmt.setDouble(4, Double.parseDouble(txtMontoIGV.getText()));  

            
            stmt.executeUpdate();
            JOptionPane.showMessageDialog(this, "Venta guardada correctamente");
        } catch (SQLException e) {
            JOptionPane.showMessageDialog(this, "Error al guardar la venta: " + e.getMessage());
        }
    }

    
    private void limpiarCampos() {
        txtCodVenta.setText("");
        txtFechaVenta.setText("");
        txtMontoTotal.setText("");
        txtMontoIGV.setText("");
    }

    
