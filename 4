    private void btnGuardarActionPerformed(java.awt.event.ActionEvent evt) {                                           
        guardarTipoProducto();
         FormularioProducto formularioProducto = new FormularioProducto();
        formularioProducto.setVisible(true); 
        
        
        dispose();
    }                                          

