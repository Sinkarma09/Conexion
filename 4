     private void guardarTipoProducto() {
        String sql = "INSERT INTO TipoProducto (CodTipoProducto, DescTipoProducto, Indicador) VALUES (?, ?, 'A')";
        
        try (Connection conexion = conexionBD.getConexion();
             PreparedStatement stmt = conexion.prepareStatement(sql)) {

            stmt.setInt(1, Integer.parseInt(txtCodTipoProducto.getText()));
            stmt.setString(2, txtDescTipoProducto.getText());

            stmt.executeUpdate();
            JOptionPane.showMessageDialog(this, "Tipo Producto guardado correctamente");
        } catch (SQLException ex) {
            JOptionPane.showMessageDialog(this, "Error al guardar el Tipo Producto: " + ex.getMessage());
        }
    }

    private void limpiarCampos() {
        txtCodTipoProducto.setText("");
        txtDescTipoProducto.setText("");
    }

    private void cancelarFormulario() {
        this.dispose(); 
    }
    
